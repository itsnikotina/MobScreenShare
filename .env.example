# Configuração do projeto. Copie para .env e preencha.
# O .env real é ignorado pelo git (não vai para o repositório).
#
# Use o script scripts/apply-config.ps1 para:
#   - gerar o config.js da Activity a partir daqui
#   - carregar estas variáveis na sessão para rodar o relay / test-client

# --- Discord Activity (usado para gerar config.js) ---
# Application ID (client id) da sua aplicação no Discord Developer Portal.
DISCORD_CLIENT_ID=1177345407513268244
# Prefixo do URL Mapping que aponta para o relay (deve casar com o Dev Portal).
RELAY_PROXY_PREFIX=/relay
# Identificadores fixos do POC.
ROOM=test-room
STREAM=test-stream

# --- Relay (lido pelo binário relay) ---
# Endereço/porta de bind do relay.
RELAY_ADDR=0.0.0.0:9000
# Caminhos PEM para servir wss:// direto. Deixe vazio para ws:// puro.
RELAY_TLS_CERT=
RELAY_TLS_KEY=

# --- Test client (publisher) ---
# URL de publicação no relay.
PUBLISH_URL=ws://127.0.0.1:9000/publish/test-room/test-stream
# Arquivo H.264 de teste.
H264_PATH=assets/test.h264
